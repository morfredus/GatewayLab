# -----------------------------------------------------------------------------
# 1. FICHIERS DE CONFIGURATION SENSIBLES ET SPECIFIQUES AU PROJET
# -----------------------------------------------------------------------------
# Fichier de configuration WiFi (sensible - NE PAS VERSIONNER)
include/secrets.h
include/wifi-config.h

# Fichiers divers (a ignorer si leur contenu n'est pas a partager)
.copilot

# Sources web extraites depuis les headers PROGMEM (récupération d'urgence)
web_src/extracted/

# -----------------------------------------------------------------------------
# 2. FICHIERS GENERES PAR COMPILATION ET OUTILS
# -----------------------------------------------------------------------------
#
# FICHIERS ET DOSSIERS PLATFORMIO / ARDUINO IDE
# ---------------------------------------------
# PlatformIO
.pio/
.lib/
.cache/
.morfredus/

# Arduino IDE (fichiers temporaires ou specifiques a l'utilisateur)
*.lss              # Fichiers de liste de compilation (Arduino IDE et autres)
*.elf.map
*.o

# Dossiers de construction (temporaires, varient selon l'IDE/Outil)
build/
.build/
tmp/
temp/
.arduino/
arduino/
hardware/

# Dossier data/ : seule la SOURCE de la table des fabricants est versionnée ; data/index.html est
# une copie générée par tools/minify_web.py (image LittleFS).
data/*
!data/oui.json

# Ressources web générées à chaque compilation (tools/custom_hooks.py -> tools/minify_web.py).
# Les sources versionnées sont web_src/ et data/oui.json.
include/web_interface*.h
include/oui_table.h

# Fichiers compilés (binaires) pour le téléchargement
*.hex
*.elf
*.bin
*.lst
*.map
*.eep
*.sym
*.suo

# -----------------------------------------------------------------------------
# 3. FICHIERS GENERES PAR L'IDE (Visual Studio Code & autres)
# -----------------------------------------------------------------------------
# Dossier de configuration local de l'espace de travail VS Code (englobe tout)
.vscode/

# Fichiers d'autres IDE/Environnements (Eclipse, etc.)
.classpath
.project
.settings
*.user
*.code-workspace

# -----------------------------------------------------------------------------
# 4. FICHIERS ET ENVIRONNEMENTS PYTHON
# -----------------------------------------------------------------------------
# Environnements virtuels
venv/
env/
VENV/
ENV/

# Byte-code Python et cache
*.pyc
__pycache__/
*.log
.Sphinx/

# -----------------------------------------------------------------------------
# 5. FICHIERS DE CACHE ET SYSTEME
# -----------------------------------------------------------------------------
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Secrets locaux : jamais versionnes
secrets.json
.env
